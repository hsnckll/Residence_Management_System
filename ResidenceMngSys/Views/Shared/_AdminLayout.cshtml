@model ResidenceMngSys.Models.UserViewModel
@inject ResidenceMngSys.Models.AppDbContext _db
@inject ResidenceMngSys.Services.ITenantService _tenantService
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"] - ResiEase</title>

    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <link rel="stylesheet" href="~/css/styles.css">
    <link rel="stylesheet" href="~/css/admin.css">

    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
</head>

<body class="admin-layout">

    <!-- Sidebar -->
    <aside class="sidebar">
        <div class="sidebar-header">
            <div class="sidebar-logo">
                <i class="fa-solid fa-building"></i>
                <span>ResiEase</span>
            </div>
        </div>

        <nav class="sidebar-nav">
            <a class="nav-item @(ViewData["ActiveMenu"]?.ToString() == "overview" ? "active" : "")"
               asp-controller="Admin" asp-action="Index">
                <i class="fa-solid fa-chart-pie"></i>
                <span>Genel Bakış</span>
            </a>
            <a class="nav-item @(ViewData["ActiveMenu"]?.ToString() == "residents" ? "active" : "")"
               asp-controller="Admin" asp-action="Residents">
                <i class="fa-solid fa-users"></i>
                <span>Sakinler</span>
            </a>
            <a class="nav-item @(ViewData["ActiveMenu"]?.ToString() == "dues" ? "active" : "")"
               asp-controller="Admin" asp-action="Dues">
                <i class="fa-solid fa-file-invoice-dollar"></i>
                <span>Aidat Yönetimi</span>
            </a>
            <a class="nav-item @(ViewData["ActiveMenu"]?.ToString() == "balances" ? "active" : "")"
               asp-controller="Admin" asp-action="Balances">
                <i class="fa-solid fa-money-check-dollar"></i>
                <span>Bakiye Onayları</span>
            </a>
            <a class="nav-item @(ViewData["ActiveMenu"]?.ToString() == "announcements" ? "active" : "")"
               asp-controller="Admin" asp-action="Announcements">
                <i class="fa-solid fa-bullhorn"></i>
                <span>Duyurular</span>
            </a>


            <details class="nav-item-dropdown" @(ViewData["ActiveMenu"]?.ToString() == "complaints" || ViewData["ActiveMenu"]?.ToString() == "suggestions" ? "open" : "")>
                <summary class="nav-item">
                    <div class="nav-item-content">
                        <i class="fa-solid fa-comments"></i>
                        <span>Şikayet ve Öneri</span>
                    </div>
                    <i class="fa-solid fa-chevron-down arrow"></i>
                </summary>
                <div class="nav-dropdown-menu">
                    <a class="nav-item sub-item @(ViewData["ActiveMenu"]?.ToString() == "complaints" ? "active" : "")"
                       asp-controller="Admin" asp-action="Complaints">
                        <i class="fa-solid fa-circle-exclamation"></i>
                        <span>Şikayetler</span>
                    </a>
                    <a class="nav-item sub-item @(ViewData["ActiveMenu"]?.ToString() == "suggestions" ? "active" : "")"
                       asp-controller="Admin" asp-action="Suggestions">
                        <i class="fa-solid fa-lightbulb"></i>
                        <span>Öneriler</span>
                    </a>
                </div>
            </details>

            <a class="nav-item @(ViewData["ActiveMenu"]?.ToString() == "daireyonetimi" ? "active" : "")"
               asp-controller="Admin" asp-action="DaireYonetimi">
                <i class="fa-solid fa-building"></i>
                <span>Daire Yönetimi</span>
            </a>

            <a class="nav-item @(ViewData["ActiveMenu"]?.ToString() == "settings" ? "active" : "")"
               asp-controller="Admin" asp-action="Settings">
                <i class="fa-solid fa-gear"></i>
                <span>Ayarlar</span>
            </a>
        </nav>

        <div class="sidebar-footer">
            <a class="logout-btn" asp-controller="Account" asp-action="Logout">
                <i class="fa-solid fa-arrow-right-from-bracket"></i>
                <span>Çıkış Yap</span>
            </a>
        </div>
    </aside>

    <!-- Main Content -->
    <main class="main-content">
        <header class="top-header">
            @* Bu şekilde view içinde contollerdeki sorgulardan yapabiliyoruz *@
            @{
                var tenant = _db.Tenants.FirstOrDefault(x => x.Id == _tenantService.GetTenantId());
            }
            <div class="header-left">
               
            </div>
            <div class="header-right">
                <div class="header-apartment-badge">
                    <i class="fa-solid fa-building"></i>
                    <div class="apartment-badge-info">
                        <span class="apartment-badge-name">@tenant?.Name</span>
                        <span class="apartment-badge-location">@tenant?.Address</span>
                    </div>
                </div>
                <div class="header-divider"></div>
                <div class="header-user">
                    <div class="user-info">
                        <div class="user-name">@Model.user?.Name @Model.user?.Surname</div>
                        <div class="user-role">Sistem Yöneticisi</div>
                    </div>
                    <div class="user-avatar">
                        @Model.user?.Name[0]@Model.user?.Surname[0]
                    </div>
                </div>
            </div>
        </header>

        <div class="content-area">
            @RenderBody()
        </div>
    </main>
    <script src="~/js/admin.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
