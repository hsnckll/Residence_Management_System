@{
    ViewData["Title"] = "Daire Yönetimi";
    ViewData["ActiveMenu"] = "daireyonetimi";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}


@model ResidenceMngSys.Models.UserViewModel


<div class="daire-page">
    <link rel="stylesheet" href="~/css/daireyonetimi.css" />
    <!-- Sayfa Başlığı -->
    <div class="daire-header">

        <div class="daire-header__left">
            <h1 class="daire-header__title">Daire yönetimi</h1>
            <p class="daire-header__meta">
                <span class="meta-total">@Model.ApartmanlarListesi.Count() kayıtlı daire</span>
                <span class="meta-dot">•</span>
                <span class="meta-dolu">@Model.ApartmanlarListesi.Count(x => x.IsOccupied == 1) dolu</span>
                <span class="meta-dot">•</span>
                <span class="meta-bos">@Model.ApartmanlarListesi.Count(x => x.IsOccupied == 0) boş</span>
            </p>
        </div>


        <div class="daire-header__actions">
            <form asp-action="topluaptolustur" asp-controller="Admin">
                <button class="daire-btn daire-btn--outline" id="btnTopluEkle">
                    <svg class="daire-btn__icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none"
                         stroke="currentColor" stroke-width="2">
                        <rect x="3" y="3" width="7" height="7" rx="1" />
                        <rect x="14" y="3" width="7" height="7" rx="1" />
                        <rect x="3" y="14" width="7" height="7" rx="1" />
                        <rect x="14" y="14" width="7" height="7" rx="1" />
                    </svg>
                    Toplu ekle
                </button>
            </form>
           
            <form asp-action="tekilaptolustur" asp-controller="Admin">
                <button class="daire-btn daire-btn--primary" id="btnTekileEkle">
                    <svg class="daire-btn__icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none"
                         stroke="currentColor" stroke-width="2">
                        <line x1="12" y1="5" x2="12" y2="19" />
                        <line x1="5" y1="12" x2="19" y2="12" />
                    </svg>
                    Tekil ekle
                </button>
            </form>

        </div>
    </div>
    @if (TempData["Hata"] != null)
    {
        <div class="custom-error">
            @TempData["Hata"]
        </div>
    }
    <!-- Filtre Sekmeleri -->

    <div class="daire-filter">
        <button class="filter-tab filter-tab--active" data-filter="tumu">
            Tümü <span class="filter-tab__count">@Model.ApartmanlarListesi.Count()</span>
        </button>
        <button class="filter-tab" data-filter="1">
            Dolu <span class="filter-tab__count">@Model.ApartmanlarListesi.Count(x => x.IsOccupied == 1)</span>
        </button>
        <button class="filter-tab" data-filter="0">
            Boş <span class="filter-tab__count">@Model.ApartmanlarListesi.Count(x => x.IsOccupied == 0)</span>
        </button>
    </div>
   
    <!-- Daire Kartları Grid -->
    <div class="daire-grid" id="daireGrid">

    @foreach(var apartmanlar in Model.ApartmanlarListesi)
    {
            <div class="daire-kart daire-kart--dolu" data-durum="@apartmanlar.IsOccupied">
                <div class="daire-kart__header">
                    <div class="daire-kart__info">
                        <h3 class="daire-kart__baslik">Blok @apartmanlar?.BlockNo - Daire @apartmanlar?.ApartmentNo</h3>
                        <p class="daire-kart__detay">@apartmanlar?.FloorNo .Kat <span class="detay-dot">•</span> @apartmanlar?.SquareMeters m² <span class="detay-dot">•</span> @apartmanlar?.Type oda</p>
                    </div>
                    @if (apartmanlar.IsOccupied == 1)
                    {
                        <span class="durum-badge durum-badge--dolu">Dolu</span>
                    }
                    else
                    {
                        <span class="durum-badge durum-badge--bos">Boş</span>
                    }
                </div>

                <div class="daire-kart__sakin">
                    <div class="sakin-avatar" style="--avatar-renk: #4f86c6;">@apartmanlar?.User?.Name[0] @apartmanlar?.User?.Surname[0]</div>
                    <div class="sakin-bilgi">
                        <span class="sakin-ad">@apartmanlar?.User?.Name @apartmanlar?.User?.Surname</span>
                        <span class="sakin-kayit">Kayıt: @apartmanlar?.User?.CreatedAt</span>
                    </div>
                </div>

                <div class="daire-kart__footer">





                    <form asp-action="daireduzenleme" asp-controller="Admin" method="get" style="width: 100%">
                        <input type="hidden" name="guncellenecekDaire" value="@apartmanlar.Id" />
                        <button class="btn-duzenle" style="width: 100%">
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7" />
                                <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z" />
                            </svg>
                            Düzenle
                        </button>
                    </form>



                    <form asp-action="dairesilme" asp-controller="Admin" method="post">
                        <input type="hidden" name="silinecekDaire" value="@apartmanlar.Id" />
                        <button class="btn-sil" onclick="return confirm('Bu daireyi silmek istediğinizden emin misiniz?')">
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                 stroke-width="2">
                                <polyline points="3 6 5 6 21 6" />
                                <path d="M19 6l-1 14H6L5 6" />
                                <path d="M10 11v6M14 11v6" />
                                <path d="M9 6V4h6v2" />
                            </svg>
                        </button>
                    </form>
                    
                </div>
            </div>
        }
    </div>





</div>







@section Scripts {
    <script>
        // Filtre sekme mantığı
        document.querySelectorAll('.filter-tab').forEach(tab => {
            tab.addEventListener('click', function () {
                document.querySelectorAll('.filter-tab').forEach(t => t.classList.remove('filter-tab--active'));
                this.classList.add('filter-tab--active');

                const filtre = this.dataset.filter;
                document.querySelectorAll('.daire-kart').forEach(kart => {
                    if (filtre === 'tumu') {
                        kart.style.display = '';
                    } else {
                        kart.style.display = kart.dataset.durum === filtre ? '' : 'none';
                    }
                });
            });
        });


    </script>
}