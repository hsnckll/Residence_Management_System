@{
    ViewData["Title"] = "Aidatlar";
    ViewData["ActiveMenu"] = "dues";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";

}
@{
    var existingMonths = ViewBag.ExistingMonths as List<string> ?? new List<string>();
}




@model ResidenceMngSys.Models.UserViewModel


    <!-- Header -->
    <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 1.5rem;">
        <div>
            <h2 class="section-title" style="margin-bottom: 0.25rem;">Aidat Yönetimi</h2>
            <p style="color: #64748b; font-size: 0.95rem;">@Model.MevcutAylar.Count() Aidat Yönetimi</p>
        </div>
        <form asp-action="aidatolusturma" asp-controller="Admin">
            <button style="background: #2563eb; color: white; padding: 0.75rem 1.25rem; border-radius: 9999px; font-weight: 500; font-size: 0.9rem; border: none; cursor: pointer; display: flex; align-items: center; gap: 0.5rem; transition: background 0.2s;"
                    onmouseover="this.style.background='#1d4ed8'" onmouseout="this.style.background='#2563eb'">
                <i class="fa-solid fa-plus"></i> Yeni Aidat
            </button>
        </form>
        
    </div>


<!-- Month Filters -->
<div style="margin-bottom: 2rem;">
    @{
        var yilaGoreGruplananlar = Model.MevcutAylar
        .Select(t => new { Tarih = t, Yil = t.Split("-")[0].Trim(), Ay = t.Split("-")[1].Trim() })
        .GroupBy(t => t.Yil)
        .OrderByDescending(g => g.Key);
    }

    @foreach (var grup in yilaGoreGruplananlar)
    {
        <div style="margin-bottom: 1rem;">
            <div style="font-size: 0.8rem; font-weight: 700; color: #94a3b8; text-transform: uppercase; margin-bottom: 0.5rem; letter-spacing: 0.05em;">
                @grup.Key
            </div>
            <div style="display: flex; flex-wrap: wrap; gap: 0.5rem;">
                @foreach (var item in grup)
                {
                    var isActive = item.Tarih.Trim().ToLower() == Model.AktifFiltre.Trim().ToLower();
                    var btnRenk = isActive
                    ? "background: #2563eb; color: white;"
                    : "background: #f1f5f9; color: #64748b;";

                    <div style="display: flex; align-items: center; gap: 4px;">
                        <form asp-action="Dues" asp-controller="Admin" method="get">
                            <input type="hidden" name="yıl" value="@item.Yil" />
                            <input type="hidden" name="ay" value="@item.Ay" />
                            <button type="submit"
                                    style="@btnRenk border: none; padding: 0.5rem 1.25rem; border-radius: 9999px; font-weight: 500; font-size: 0.9rem; cursor: pointer;">
                                @item.Ay
                            </button>
                        </form>

                        @if (isActive)
                        {
                            <form asp-action="aidatDuzenleme" asp-controller="Admin" method="get">
                                <input type="hidden" name="yıl" value="@item.Yil" />
                                <input type="hidden" name="ay" value="@item.Ay" />
                                <button style="display: inline-flex; align-items: center; justify-content: center; width: 28px; height: 28px; background: #eff6ff; color: #2563eb; border-radius: 50%; text-decoration: none; font-size: 0.75rem;" 
                                type="submit">
                                <i class="fa-solid fa-pen"></i></button>
                            </form>
                        }
                    </div>
                }
            </div>

           
        </div>
    }
</div>
 

    <!-- Cards Grid -->
    <div style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 1.5rem; margin-bottom: 2rem;">
        <!-- Card 1 -->
        <div style="background: white; border: 1px solid #e2e8f0; border-radius: 1rem; padding: 1.5rem;">
            <div style="width: 40px; height: 40px; border-radius: 0.75rem; background: #eff6ff; color: #3b82f6; display: flex; align-items: center; justify-content: center; font-size: 1.25rem; margin-bottom: 1.5rem;">
                <i class="fa-solid fa-credit-card"></i>
            </div>
        <div id="duesPrice" style="font-size: 1.5rem; font-weight: 700; color: #0f172a; margin-bottom: 0.25rem;">@Model.SeciliAidatTutari.ToString("N0") ₺</div>
            <div style="color: #64748b; font-size: 0.9rem;">Aidat Tutarı</div>
        </div>
        <!-- Card 2 -->
        <div style="background: white; border: 1px solid #e2e8f0; border-radius: 1rem; padding: 1.5rem;">
            <div style="width: 40px; height: 40px; border-radius: 0.75rem; background: #dcfce7; color: #10b981; display: flex; align-items: center; justify-content: center; font-size: 1.25rem; margin-bottom: 1.5rem;">
                <i class="fa-solid fa-arrow-trend-up"></i>
            </div>
            <div style="font-size: 1.5rem; font-weight: 700; color: #0f172a; margin-bottom: 0.25rem;">
                @Model.odenentotalaidat.ToString("N2") ₺
            </div>
            <div style="color: #64748b; font-size: 0.9rem;">Toplanan</div>
        </div>
        <!-- Card 3 -->
        <div style="background: white; border: 1px solid #e2e8f0; border-radius: 1rem; padding: 1.5rem;">
            <div style="width: 40px; height: 40px; border-radius: 0.75rem; background: #ffedd5; color: #f97316; display: flex; align-items: center; justify-content: center; font-size: 1.25rem; margin-bottom: 1.5rem;">
                <i class="fa-solid fa-circle-exclamation"></i>
            </div>
            <div id="remainingDebt" style="font-size: 1.5rem; font-weight: 700; color: #0f172a; margin-bottom: 0.25rem;">
            @Model.SeciliKalanBorc.ToString("N0") ₺
            </div>
            <div style="color: #64748b; font-size: 0.9rem;">Kalan Borç</div>
        </div>
        <!-- Card 4 -->
        <div style="background: white; border: 1px solid #e2e8f0; border-radius: 1rem; padding: 1.5rem;">
            <div style="width: 40px; height: 40px; border-radius: 0.75rem; background: #f3e8ff; color: #a855f7; display: flex; align-items: center; justify-content: center; font-size: 1.25rem; margin-bottom: 1.5rem;">
                <i class="fa-solid fa-users"></i>
            </div>
            <div style="font-size: 1.5rem; font-weight: 700; color: #0f172a; margin-bottom: 0.25rem;">
                 % @Model.yuzdelik.ToString("N2")
            </div>
            <div style="color: #64748b; font-size: 0.9rem;">Tahsilat Oranı</div>
        </div>
    </div>


@* Yeni Aidat Oluşturma 
<div class="modal-overlay" id="newDueModal" style="display:none;">
    <div class="modal-content">
        <div class="modal-header">
            <h2>Yeni Aidat Oluştur</h2>
            <button class="btn-close" id="closeDueModal"><i class="fa-solid fa-xmark"></i></button>
        </div>

        <form method="post" asp-action="CreateDue" asp-controller="Admin">

            <input type="hidden" name="year" value="@DateTime.Now.Year">

            <div class="form-group">
                <label>Yıl</label>
                <div class="year-badge">@DateTime.Now.Year</div>
            </div>

            <div class="form-group">
                <label>Ay</label>
                <div class="month-grid">
                    @{
                        var turkishMonths = new[] { "Ocak","Şubat","Mart","Nisan","Mayıs","Haziran",
                                        "Temmuz","Ağustos","Eylül","Ekim","Kasım","Aralık" };
                        var existingMonths = ViewBag.ExistingMonths as List<string> ?? new List<string>();
                    }
                    @foreach (var month in turkishMonths)
                    {
                        var isExisting = existingMonths.Contains(month);
                        <label class="month-btn @(isExisting ? "month-used" : "month-available")">
                            <input type="radio" name="Months" value="@month"
                                   @(isExisting ? "disabled" : "") hidden>
                            @month
                        </label>
                    }
                </div>
            </div>

            <div class="form-group">
                <label>Aidat Tutarı (₺)</label>
                <input type="number" name="DuesPrice" placeholder="1200">
            </div>

            <div style="display:grid; grid-template-columns:1fr 1fr; gap:10px;">
                <div class="form-group">
                    <label>Ödeme Başlangıcı</label>
                    <input type="date" name="PaymentStartDate">
                </div>
                <div class="form-group">
                    <label>Ödeme Sonu</label>
                    <input type="date" name="PaymentEndDate">
                </div>
            </div>

            <button type="submit" class="btn-primary" style="width:100%; margin-top:1rem;">Oluştur</button>
        </form>
    </div>
</div>*@


    <!-- Progress Bar Card -->
<div style="background: white; border: 1px solid #e2e8f0; border-radius: 1rem; padding: 1.5rem; margin-bottom: 2rem;">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.75rem;">
        <span style="color: #475569; font-weight: 500; font-size: 0.95rem;">Genel Tahsilat Durumu</span>
        <span style="color: #0f172a; font-weight: 700; font-size: 0.95rem;">%@Model.yuzdelik.ToString("N2")</span>
    </div>

    <div style="width: 100%; height: 16px; background: #f1f5f9; border-radius: 9999px; margin-bottom: 1rem; overflow: hidden; border: 1px solid #e2e8f0;">
        <div class="super-active-bar"
             style="width: @Model.yuzdelik.ToString(System.Globalization.CultureInfo.InvariantCulture)%;
                    background-color: @(Model.yuzdelik >= 80 ? "#22c55e" : (Model.yuzdelik >= 40 ? "#eab308" : "#ef4444"));">
        </div>
    </div>
    @foreach(var ay in Model.SeciliAyinKayitlari.Select(x=>new { x.Months , x.Year}).Distinct())
                                                      // { Months = 3, Year = 2024 } buradaki kod buna karşılık geliyor
    {
        <div style="color: #94a3b8; font-size: 0.8rem; display: flex; align-items: center; gap: 0.4rem;">
            <i class="fa-regular fa-calendar"></i> Ödeme Aralığı ( @ay.Months / @ay.Year )
        </div>
    }
    
</div>

    <!-- Table Wrapper -->
    <div style="background: white; border: 1px solid #e2e8f0; border-radius: 1rem; overflow: hidden;">
        <div style="padding: 1.5rem; border-bottom: 1px solid #e2e8f0;">
            <h3 style="font-size: 1.1rem; font-weight: 600; color: #0f172a; margin: 0;">
                Sakin Ödeme Durumları
            </h3>
        </div>
        <div style="overflow-x: auto;">
            <table style="width: 100%; border-collapse: collapse; min-width: 800px;">
                <thead>
                    <tr style="background: #f8fafc; border-bottom: 1px solid #e2e8f0;">
                        <th style="text-align: left; padding: 1rem 1.5rem; font-size: 0.75rem; font-weight: 700; color: #64748b; text-transform: uppercase;">
                            Sakin
                        </th>
                        <th style="text-align: center; padding: 1rem 1.5rem; font-size: 0.75rem; font-weight: 700; color: #64748b; text-transform: uppercase;">
                            Toplam Borç
                        </th>
                        <th style="text-align: center; padding: 1rem 1.5rem; font-size: 0.75rem; font-weight: 700; color: #64748b; text-transform: uppercase;">
                            Ödenen
                        </th>
                        <th style="text-align: center; padding: 1rem 1.5rem; font-size: 0.75rem; font-weight: 700; color: #64748b; text-transform: uppercase;">
                            Kalan
                        </th>
                        <th style="text-align: center; padding: 1rem 1.5rem; font-size: 0.75rem; font-weight: 700; color: #64748b; text-transform: uppercase;">
                            Durum
                        </th>
                    </tr>
                </thead>
                <tbody>
                    <!-- Row 1 -->
                @foreach (var odeyenKisiler in Model.aidatıodeyenkisiler)
                {
                    <tr style="border-bottom: 1px solid #e2e8f0; transition: background 0.2s;"
                    onmouseover="this.style.background='#f8fafc'"
                        onmouseout="this.style.background='transparent'">
                        <td style="padding: 1rem 1.5rem;">
                            <div style="color: #0f172a; font-weight: 500; font-size: 0.95rem; margin-bottom: 0.25rem;">
                               @odeyenKisiler.Apartment?.User?.Name @odeyenKisiler.Apartment?.User?.Surname
                            </div>
                            <div style="color: #94a3b8; font-size: 0.8rem; margin-bottom: 0.25rem;">
                                @odeyenKisiler.Apartment.BlockNo Blok - @odeyenKisiler.Apartment.FloorNo .Kat - @odeyenKisiler.Apartment.ApartmentNo .Daire
                            </div>
                        </td>
                        <td style="padding: 1rem 1.5rem; text-align: center; color: #475569; font-weight: 500; font-size: 0.95rem;">
                            @odeyenKisiler.DuesPrice.ToString("N2") ₺
                        </td>
                        <td style="padding: 1rem 1.5rem; text-align: center; color: #10b981; font-weight: 500; font-size: 0.95rem;">
                            @((odeyenKisiler.DuesPrice - odeyenKisiler.RemainingDebt).ToString("N2")) ₺
                        </td>
                        <td style="padding: 1rem 1.5rem; text-align: center; color: #ef4444; font-weight: 500; font-size: 0.95rem;">
                            @odeyenKisiler.RemainingDebt.ToString("N2") ₺
                        </td>
                        <td style="padding: 1rem 1.5rem; text-align: center;">
                            <div style="display: inline-flex; align-items: center; gap: 0.4rem; background: #eff6ff; color: #3b82f6; font-size: 0.8rem; padding: 0.25rem 0.75rem; border-radius: 9999px; font-weight: 500;">
                                @if (odeyenKisiler?.IsPaid == 1)
                                {
                                    <span style="background: #dcfce7; color: #15803d; font-size: 0.75rem; padding: 0.15rem 0.6rem; border-radius: 9999px; font-weight: 500; display: inline-flex; align-items: center; gap: 0.3rem;">
                                        <i class="fa-solid fa-circle-check"></i> Ödendi
                                    </span>
                                }
                                else
                                {
                                    <span style="background: #ffedd5; color: #ea580c; font-size: 0.75rem; padding: 0.15rem 0.6rem; border-radius: 9999px; font-weight: 500; display: inline-flex; align-items: center; gap: 0.3rem;">
                                        <i class="fa-regular fa-clock"></i> Beklemede
                                    </span>
                                }

                            </div>
                        </td>
                    </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>



<style>
    /* Çubuğun dolma animasyonu */
    @@keyframes fillProgress {
        from {
            width: 0%;
        }

        to {
            width: @Model.yuzdelik.ToString(System.Globalization.CultureInfo.InvariantCulture) %;
        }
    }

    /* Hem kayma hem de parlama efekti */
    @@keyframes pulseStripes {
        0% {
            background-position: 0 0;
            opacity: 0.8;
        }

        50% {
            opacity: 1;
        }

        100% {
            background-position: 50px 0;
            opacity: 0.8;
        }
    }

    .super-active-bar {
        height: 100%;
        border-radius: 9999px;
        position: relative;
        overflow: hidden;
        /* Çapraz kalın çizgiler */
        background-image: linear-gradient( 135deg, rgba(255, 255, 255, .3) 25%, transparent 25%, transparent 50%, rgba(255, 255, 255, .3) 50%, rgba(255, 255, 255, .3) 75%, transparent 75%, transparent );
        background-size: 50px 50px;
        /* İki animasyon bir arada: Dolma ve Hareket/Parlama */
        animation: fillProgress 2s ease-out forwards, pulseStripes 1.2s linear infinite;
        box-shadow: 0 0 15px rgba(0,0,0,0.1);
    }
</style>
