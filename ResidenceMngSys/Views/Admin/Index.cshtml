@{
    ViewData["Title"] = "Genel Bakış";
    ViewData["ActiveMenu"] = "overview";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}


@model ResidenceMngSys.Models.UserViewModel



<h2 class="section-title">Genel Bakış</h2>
<div class="widgets-grid">
    <div class="widget-card">
        <div class="widget-icon blue"><i class="fa-solid fa-users"></i></div>
        <div class="widget-info">
            <h3>Toplam Sakin</h3>
            <p>@Model.totaluser</p>
        </div>
    </div>
    <div class="widget-card">
        <div class="widget-icon green"><i class="fa-solid fa-wallet"></i></div>
        <div class="widget-info">
            <h3>Toplam Tahsilat</h3>
            <p>@Model.totalToplananAidat.Value.ToString("N2") ₺</p>
        </div>
    </div>
    <div class="widget-card">
        <div class="widget-icon red"><i class="fa-solid fa-circle-exclamation"></i></div>
        <div class="widget-info">
            <h3>Toplam Borç</h3>
            <p>@Model.totalborc.ToString("N2") ₺</p>
        </div>
    </div>

    <div class="widget-card">
        <div class="widget-icon yellow"><i class="fa-solid fa-clipboard-check"></i></div>
        <div class="widget-info">
            <h3>Bekleyen Onaylar</h3>
            <p>@Model.bekleyenonaylar</p>
        </div>
    </div>

</div>

<div class="dashboard-grid">


    <div class="card">
        <div class="card-header">
            <h3 class="card-title">Aylık Tahsilat Grafiği</h3>
        </div>
        <div style="position: relative; height: 300px; width: 100%;">
            <canvas id="paymentsChart"></canvas>
        </div>
    </div>



    <!-- Borcu Olan Sakinler -->
    <div class="card">
        <div class="card-header">
            <h3 class="card-title">Sakin Borç Durumu</h3>
        </div>

        <div class="card-body" style="max-height: 400px; overflow-y: auto; padding-right: 5px;">
            @foreach (var borclular in Model.borcuolansakinler)
            {
                <div style="display: flex; flex-direction: column; gap: 1rem; margin-top: 0.5rem; margin-bottom: 0.5rem; border-bottom: 1px solid #f1f5f9; padding-bottom: 0.5rem;">
                    <div style="display: flex; justify-content: space-between; align-items: center;">
                        <div style="display: flex; align-items: center; gap: 1rem;">
                            <div style="width:40px;height:40px;border-radius:50%;background:#f1f5f9;color:#334155;display:flex;align-items:center;justify-content:center;font-size:0.9rem;font-weight:500;">
                                @borclular.Apartment?.User?.Name[0]@borclular.Apartment?.User?.Surname[0]
                            </div>
                            <div>
                                <div style="color:#0f172a;font-weight:500;">@borclular.Apartment?.User?.Name @borclular.Apartment?.User?.Surname</div>
                                <div style="color:#94a3b8;font-size:0.85rem;">@borclular.Apartment?.BlockNo Blok @borclular.Apartment?.FloorNo .Kat @borclular.Apartment?.ApartmentNo .Daire</div>
                            </div>
                        </div>
                        <div style="color:#dc2626;font-weight:500;">@borclular.RemainingDebt.ToString("N2") ₺</div>
                    </div>
                </div>
            }
        </div>
    </div>

</div>

<div class="dashboard-grid" style="grid-template-columns: 1fr 1fr;">
    <div class="card">
        <div class="card-header" style="display: flex; justify-content: space-between; align-items: center;">
            <h3 class="card-title">Son Ödenen Aidatlar</h3>
        </div>

        <div class="card-body" style="max-height: 400px; overflow-y: auto; padding: 1rem;">
            <ul style="display: flex; flex-direction: column; gap: 1rem; list-style: none; padding: 0; margin: 0;">
                @foreach (var odenenler in Model.EnSonOdenenAidatlar)
                {
                    <li style="display:flex; justify-content:space-between; align-items:center; font-size:0.9rem; padding-bottom:1rem; border-bottom:1px solid #f1f5f9;">
                        <div style="display:flex; align-items:center; gap:1rem;">
                            <div style="width:40px; height:40px; border-radius:50%; background:#DCFCE7; color:#16A34A; display:flex; align-items:center; justify-content:center; flex-shrink: 0;">
                                <i class="fa-solid fa-check"></i>
                            </div>
                            <div>
                                <div style="font-weight:600; color:#0f172a;">@odenenler.Apartment.User.Name @odenenler.Apartment.User.Surname</div>
                                <div style="color:#94a3b8; font-size:0.8rem;">
                                    <i class="fa-regular fa-calendar-check" style="font-size: 0.75rem;"></i> Aidat: @odenenler.Months - @odenenler.Year
                                </div>
                            </div>
                        </div>

                        <div style="display: flex; flex-direction: column; align-items: flex-end; gap: 0.25rem;">
                            <span class="status-badge status-success" style="margin: 0; font-weight: 600;">
                                @odenenler.DuesPrice.ToString("N2") ₺
                            </span>
                            <span style="color:#94a3b8; font-size:0.75rem; white-space: nowrap;">
                                @odenenler.PaymentDate.Value.ToString("g")
                            </span>
                        </div>
                    </li>
                }
            </ul>

            @if (!Model.EnSonOdenenAidatlar.Any())
            {
                <div style="text-align: center; color: #94a3b8; padding: 2rem; font-size: 0.9rem;">
                    Henüz kayıtlı bir ödeme bulunmamaktadır.
                </div>
            }
        </div>
    </div>



    <div class="card">
        <div class="card-header" style="display: flex; justify-content: space-between; align-items: center;">
            <h3 class="card-title">Gelen Şikayet Talepleri</h3>
        </div>

        <div class="card-body" style="max-height: 400px; overflow-y: auto; padding: 1rem;">
            <ul style="display: flex; flex-direction: column; gap: 1rem; list-style: none; padding: 0; margin: 0;">
                @foreach (var sikayetler in Model.ensonSikayetler.Where(x => x.Status != "Tamamlandı"))
                {
                    <li style="display:flex; justify-content:space-between; align-items:center; font-size:0.9rem; padding-bottom: 1rem; border-bottom: 1px solid #f1f5f9;">
                        <div style="display:flex; align-items:center; gap:1rem;">
                            <div style="width:40px; height:40px; border-radius:50%; background:#FEE2E2; color:#DC2626; display:flex; align-items:center; justify-content:center; flex-shrink: 0;">
                                <i class="fa-solid fa-triangle-exclamation"></i>
                            </div>

                            <div>
                                <div style="font-weight:600; color:#0f172a;">
                                    @sikayetler.Apartment.User.Name @sikayetler.Apartment.User.Surname
                                    <span style="color:#64748b; font-weight:400; font-size:0.8rem;">(@sikayetler.Topic)</span>
                                </div>
                                <div style="color:#94a3b8; font-size:0.8rem; margin-top: 2px;">
                                    <i class="fa-regular fa-clock" style="font-size: 0.75rem;"></i> @sikayetler.CreatedAt.ToString("g")
                                </div>
                            </div>
                        </div>

                        <div>
                            @if (sikayetler.Status == "İşlemde")
                            {
                                <span style="font-size: 0.75rem; padding: 4px 8px; border-radius: 6px; background: #eff6ff; color: #1d4ed8; border: 1px solid #dbeafe; font-weight: 500;">
                                    <i class="fa-solid fa-spinner fa-spin" style="font-size: 0.7rem; margin-right: 3px;"></i> @sikayetler.Status
                                </span>
                            }
                            else if (sikayetler.Status == "Beklemede")
                            {
                                <span style="font-size: 0.75rem; padding: 4px 8px; border-radius: 6px; background: #fff7ed; color: #c2410c; border: 1px solid #ffedd5; font-weight: 500;">
                                    @sikayetler.Status
                                </span>
                            }
                        </div>
                    </li>
                }
            </ul>

            @if (!Model.ensonSikayetler.Any(x => x.Status != "Tamamlandı"))
            {
                <div style="text-align: center; color: #94a3b8; padding: 2rem; font-size: 0.9rem;">
                    Aktif şikayet talebi bulunmamaktadır.
                </div>
            }
        </div>
    </div>
</div>






@* Javascript Kodları *@
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script>
    const ctx = document.getElementById('paymentsChart').getContext('2d');

    const gradBlue = ctx.createLinearGradient(0, 0, 0, 300);
    gradBlue.addColorStop(0, 'rgba(55,138,221,0.3)');
    gradBlue.addColorStop(1, 'rgba(55,138,221,0.0)');

    const gradGreen = ctx.createLinearGradient(0, 0, 0, 300);
    gradGreen.addColorStop(0, 'rgba(29,158,117,0.35)');
    gradGreen.addColorStop(1, 'rgba(29,158,117,0.0)');

    const labels    = @Html.Raw(ViewBag.ChartLabels);
    const generated = @Html.Raw(ViewBag.ChartGenerated);
    const collected = @Html.Raw(ViewBag.ChartCollected);

    new Chart(ctx, {
        type: 'line',
        data: {
            labels: labels,
            datasets: [
                {
                    label: 'Oluşturulan Aidat',
                    data: generated,
                    borderColor: '#378ADD',
                    borderWidth: 2,
                    pointBackgroundColor: '#378ADD',
                    pointRadius: 4,
                    pointHoverRadius: 6,
                    fill: true,
                    backgroundColor: gradBlue,
                    tension: 0.4
                },
                {
                    label: 'Tahsil Edilen',
                    data: collected,
                    borderColor: '#1D9E75',
                    borderWidth: 2,
                    pointBackgroundColor: '#1D9E75',
                    pointRadius: 4,
                    pointHoverRadius: 6,
                    fill: true,
                    backgroundColor: gradGreen,
                    tension: 0.4
                }
            ]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            interaction: { mode: 'index', intersect: false },
            plugins: {
                legend: {
                    display: true,
                    position: 'top',
                    labels: {
                        usePointStyle: true,
                        pointStyle: 'line',
                        padding: 20,
                        font: { size: 13 }
                    }
                },
                tooltip: {
                    backgroundColor: 'rgba(255,255,255,0.95)',
                    titleColor: '#1a1a2e',
                    bodyColor: '#444',
                    borderColor: 'rgba(0,0,0,0.08)',
                    borderWidth: 1,
                    padding: 12,
                    callbacks: {
                        label: ctx => ' ' + ctx.dataset.label + ': ₺' + ctx.parsed.y.toLocaleString('tr-TR')
                    }
                }
            },
            scales: {
                x: {
                    grid: { display: false },
                    border: { display: false },
                    ticks: { font: { size: 12 }, color: '#888', autoSkip: false }
                },
                y: {
                    grid: { color: 'rgba(128,128,128,0.08)' },
                    border: { display: false },
                    ticks: {
                        font: { size: 11 },
                        color: '#888',
                        callback: v => '₺' + v.toLocaleString('tr-TR')
                    }
                }
            }
        }
    });
</script>