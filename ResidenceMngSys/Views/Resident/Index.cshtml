@{
    ViewData["Title"] = "Genel Bakış";
    ViewData["ActiveMenu"] = "overview";
    Layout = "~/Views/Shared/_ResidentLayout.cshtml";
}

@model ResidenceMngSys.Models.UserViewModel

<div style="margin-bottom: 2rem;">
    <h1 style="font-size: 1.75rem; font-weight: 600; color: #0f172a; margin-bottom: 0.25rem;">Hoş geldin, @Model.user.Name @Model.user.Surname </h1>
    <p style="color: #64748b; font-size: 0.95rem;">@Model.user.Apartment.BlockNo Blok - @Model.user.Apartment.FloorNo .Kat - @Model.user.Apartment.ApartmentNo .Daire</p>
</div>

<!-- 2. Balance Cards (2 columns) -->
<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; margin-bottom: 1.5rem;">
    <!-- Card 1: Mevcut Bakiye -->
    <div style="background: #ffffff; border: 1px solid #e2e8f0; border-radius: 1rem; padding: 1.5rem; display: flex; flex-direction: column; justify-content: space-between;">
        <div style="width: 40px; height: 40px; border-radius: 0.5rem; background: #e0f2fe; color: #0284c7; display: flex; align-items: center; justify-content: center; font-size: 1.25rem; margin-bottom: 1rem;">
            <i class="fa-solid fa-wallet"></i>
        </div>
        <div>
            <div style="font-size: 1.5rem; font-weight: 700; color: #0f172a;">   @Model.wallet.Balance.ToString("N2") ₺</div>
            <div style="color: #64748b; font-size: 0.9rem;">Mevcut Bakiye</div>
        </div>
    </div>
    <!-- Card 2: Toplam Borcum -->
    <div style="background: #fef2f2; border: 1px solid #fecaca; border-radius: 1rem; padding: 1.5rem; display: flex; flex-direction: column; justify-content: space-between;">
        <div style="width: 40px; height: 40px; border-radius: 0.5rem; background: #fee2e2; color: #dc2626; display: flex; align-items: center; justify-content: center; font-size: 1.25rem; margin-bottom: 1rem;">
            <i class="fa-solid fa-arrow-trend-down"> </i>
        </div>
        <div>
            <div style="font-size: 1.5rem; font-weight: 700; color: #dc2626;">@Model.DuesList.Sum(x => x.RemainingDebt).ToString("N2") ₺</div>
            <div style="color: #dc2626; font-size: 0.9rem;">Toplam Borcum</div>
        </div>
    </div>
</div>

<!-- 3. Current Due Alert Card -->
<!-- 3. Current Due Alert Card -->
@if (Model.DuesList != null && Model.DuesList.Any())
{
    var latestDue = Model.DuesList.OrderByDescending(x => x.Id).FirstOrDefault();
    <div style="background: #fffbeb; border: 1px solid #fde68a; border-radius: 1rem; padding: 1.5rem; margin-bottom: 1.5rem; display: flex; align-items: center; justify-content: space-between;">
        <div>
            <div style="display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.5rem;">
                <i class="fa-regular fa-credit-card" style="color: #d97706; font-size: 1.25rem;"></i>
                <h3 style="color: #d97706; font-size: 1.1rem; font-weight: 600;">@latestDue.Months - @latestDue.Year</h3>
            </div>
            <p style="color: #475569; font-size: 0.9rem; margin-bottom: 0.25rem;">
                Aidat Tutarı: @latestDue.DuesPrice ₺ - Kalan Tutar: @latestDue.RemainingDebt ₺
            </p>
            <p style="color: #94a3b8; font-size: 0.85rem;">
                Ödeme tarihi: @latestDue.PaymentStartDate - @latestDue.PaymentEndDate
            </p>
        </div>
        <form asp-controller="Resident" asp-action="Payments">
            <button type="submit" style="background: #2563eb; color: white; padding: 0.75rem 1.5rem; border-radius: 9999px; font-weight: 600; font-size: 0.95rem; border: none; cursor: pointer;">
                Aidat Öde
            </button>
        </form>
    </div>
}
else
{
    <div style="background: #f0fdf4; border: 1px solid #bbf7d0; border-radius: 1rem; padding: 1.5rem; margin-bottom: 1.5rem; text-align: center;">
        <i class="fa-solid fa-circle-check" style="color: #16a34a; font-size: 1.5rem; margin-bottom: 0.5rem;"></i>
        <p style="color: #16a34a; font-weight: 500;">Henüz aidat kaydı bulunmuyor.</p>
    </div>
}





<!-- 4. Aidat Geçmişim -->
<div class="card" style="margin-bottom: 1.5rem;">
    <div class="card-header">
        <h3 class="card-title">
            <i class="fas fa-history" style="margin-right: 0.5rem; color: var(--primary-color);"></i>
            Aidat Geçmişim
        </h3>
    </div>

    <div class="history-scroll-area">
        <ul style="display: flex; flex-direction: column; gap: 0.5rem; list-style: none; padding: 0; margin: 0;">

            @foreach (var due in Model.DuesList)
            {
                var isPaid = due.RemainingDebt == 0;

                <li style="display: flex; justify-content: space-between; align-items: center; padding: 1rem; border-bottom: 1px solid var(--border-color); transition: background 0.2s;"
                    onmouseover="this.style.background='var(--primary-light)'"
                    onmouseout="this.style.background='transparent'">

                    <div>
                        <div style="display: flex; align-items: center; gap: 0.75rem; margin-bottom: 0.25rem;">
                            <span style="color: var(--text-main); font-size: 0.95rem; font-weight: 600;">
                                @due.Months / @due.Year
                            </span>

                            @if (isPaid)
                            {
                                <span class="status-badge status-success">Ödendi</span>
                            }
                            else
                            {
                                <span class="status-badge status-danger">Bekliyor</span>
                            }
                        </div>
                        <div style="color: var(--text-muted); font-size: 0.8rem;">Dönem Aidatı</div>
                    </div>

                    <div style="text-align: right;">
                        <div style="color: var(--text-main); font-size: 1rem; font-weight: 700;">
                            @due.DuesPrice.ToString("C2")
                        </div>
                        @if (!isPaid)
                        {
                            <div style="color: var(--danger); font-size: 0.8rem; font-weight: 500;">
                                Kalan Borç: @due.RemainingDebt.ToString("C2")
                            </div>
                        }
                        else
                        {
                            <div style="color: var(--text-muted); font-size: 0.8rem;">Borç Yok</div>
                        }
                    </div>
                </li>
            }

        </ul>
    </div>
</div>



<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem;">
<!-- Son Ödemelerim -->
    <div class="card" style="background: #ffffff; border: 1px solid #e2e8f0; border-radius: 1rem; padding: 1.5rem;">
        <h3 class="card-title" style="font-size: 1.1rem; font-weight: 600; color: #0f172a; margin-bottom: 1.5rem;">
            Son Ödemelerim
        </h3>
        <div class="history-scroll-area">
            <ul style="display: flex; flex-direction: column; gap: 1rem; list-style: none; padding: 0; margin: 0;">
                @foreach (var due in Model.DuesList.Where(x => x.IsPaid == 1).ToList())
                {
                    <li style="display: flex; justify-content: space-between; align-items: center; padding-bottom: 1rem; border-bottom: 1px solid #f1f5f9;">
                        <div style="display: flex; align-items: center; gap: 1rem;">
                            <div style="width: 32px; height: 32px; border-radius: 50%; background: #dcfce7; color: #16a34a; display: flex; align-items: center; justify-content: center; font-size: 0.85rem;">
                                <i class="fa-solid fa-check"></i>
                            </div>
                            <div>
                                <div style="color: #334155; font-size: 0.95rem; font-weight: 500;">
                                    @due.Months / @due.Year
                                </div>
                                <div style="color: #94a3b8; font-size: 0.8rem;">
                                    Ödeme Zamanı: @due?.PaymentDate
                                </div>
                            </div>
                        </div>
                        <div style="color: #10b981; font-weight: 600; font-size: 0.95rem;">
                            @due.DuesPrice.ToString("N2") ₺
                        </div>
                    </li>
                }
            </ul>
        </div>
    </div>

   
    <div style="background: #ffffff; border: 1px solid #e2e8f0; border-radius: 1rem; padding: 1.5rem;">
        <h3 style="font-size: 1.1rem; font-weight: 600; color: #0f172a; margin-bottom: 1.5rem;">
            Bakiye Taleplerim
        </h3>
        <ul style="display: flex; flex-direction: column; gap: 1rem;">
            @if (!Model.bakiyetalepleri.Any())
            {
                <li style="display: flex; justify-content: center; align-items: center; padding: 2rem 0; color: #94a3b8; font-size: 0.9rem; gap: 0.5rem;">
                    <i class="fa-regular fa-circle-check"></i> Bekleyen talebiniz bulunmamaktadır.
                </li>
            }
            else
            {
                @foreach (var talepler in Model.bakiyetalepleri)
                {
                    <li style="display: flex; justify-content: space-between; align-items: center;">
                        <div style="display: flex; align-items: center; gap: 1rem;">
                            <div style="width: 32px; height: 32px; border-radius: 50%; background: #ffedd5; color: #ea580c; display: flex; align-items: center; justify-content: center; font-size: 0.85rem;">
                                <i class="fa-regular fa-clock"></i>
                            </div>
                            <div>
                                <div style="color: #334155; font-size: 0.95rem; font-weight: 500;">@talepler.Amount.ToString("N2") ₺</div>
                                <div style="color: #94a3b8; font-size: 0.8rem;">@talepler.CreatedAt.ToString("g")</div>
                            </div>
                        </div>
                        <span style="background: #ffedd5; color: #ea580c; font-size: 0.75rem; padding: 0.2rem 0.5rem; border-radius: 0.25rem; font-weight: 500;">Bekliyor</span>
                    </li>
                }
            }
        </ul>
    </div>
</div>

