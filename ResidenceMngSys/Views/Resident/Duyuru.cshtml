@{
    ViewData["Title"] = "Duyurular";
    ViewData["ActiveMenu"] = "duyuru";
    Layout = "~/Views/Shared/_ResidentLayout.cshtml";
}

@model ResidenceMngSys.Models.UserViewModel

<div style="margin-bottom: 2rem;">
    <h2 class="section-title" style="margin-bottom: 0.25rem;">Duyurular</h2>
    <p style="color: #64748b; font-size: 0.95rem;">Apartman yönetiminden duyurular ve bildirimler.</p>
</div>
<h3 style="font-size: 0.85rem; font-weight: 700; color: #d97706; text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 1rem; display: flex; align-items: center; gap: 0.5rem;">
    <i class="fa-solid fa-triangle-exclamation"></i> ACİL DUYURULAR
</h3>
<!-- Acil Duyurular -->
@foreach (var duyuru in Model.duyurular.Where(x=>x.ImportanceStatus=="Önemli" || x.ImportanceStatus=="Acil").ToList())
{

    <div style="margin-bottom: 2rem;">
        
            <div style="display: flex; flex-direction: column; gap: 1rem;">
                <!-- Acil 1 -->
                <div style="background: #fffbeb; border: 1px solid #fde68a; border-radius: 1rem; padding: 1.5rem; display: flex; gap: 1rem;">
                    <div style="width: 40px; height: 40px; border-radius: 50%; background: #ffedd5; color: #ea580c; display: flex; align-items: center; justify-content: center; font-size: 1.1rem; flex-shrink: 0;">
                        <i class="fa-solid fa-triangle-exclamation"></i>
                    </div>
                    <div>
                        <div style="display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.25rem;">
                            <h4 style="font-size: 1.1rem; font-weight: 600; color: #9a3412;">
                                @duyuru.Title
                            </h4>
                            <span style="background: #fed7aa; color: #c2410c; font-size: 0.75rem; padding: 0.15rem 0.5rem; border-radius: 0.75rem; font-weight: 600;">@duyuru.ImportanceStatus</span>
                        </div>
                        <div style="color: #d97706; font-size: 0.85rem; margin-bottom: 0.75rem; display: flex; align-items: center; gap: 0.4rem;">
                            <i class="fa-regular fa-calendar"></i> @duyuru.CreatedAt
                        </div>
                        <p style="color: #b45309; font-size: 0.95rem; line-height: 1.5;">
                            @duyuru.Contents
                        </p>
                    </div>
                </div>
            </div>
     </div>
 } 
    
    <!-- Genel Duyurular -->
@foreach (var duyuru in Model.duyurular.Where(x => x.ImportanceStatus != "Önemli" && x.ImportanceStatus != "Acil").ToList())
{

        <div>
            <h3 style="font-size: 0.85rem; font-weight: 700; color: #64748b; text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 1rem; display: flex; align-items: center; gap: 0.5rem;">
                <i class="fa-solid fa-bullhorn"></i> GENEL DUYURULAR
            </h3>
            <div style="display: flex; flex-direction: column; gap: 1rem;">
                <!-- Genel 1 -->
                <div style="background: white; border: 1px solid #e2e8f0; border-radius: 1rem; padding: 1.5rem; display: flex; gap: 1rem;">
                    <div style="width: 40px; height: 40px; border-radius: 50%; background: #e0f2fe; color: #0284c7; display: flex; align-items: center; justify-content: center; font-size: 1.1rem; flex-shrink: 0;">
                        <i class="fa-solid fa-bullhorn"></i>
                    </div>
                    <div>
                        <h4 style="font-size: 1.1rem; font-weight: 600; color: #0f172a; margin-bottom: 0.25rem;">
                            @duyuru.Title
                        </h4>
                        <div style="color: #94a3b8; font-size: 0.85rem; margin-bottom: 0.75rem; display: flex; align-items: center; gap: 0.4rem;">
                            <i class="fa-regular fa-calendar"></i> @duyuru.CreatedAt
                        </div>
                        <p style="color: #475569; font-size: 0.95rem; line-height: 1.5;">
                            @duyuru.Contents
                        </p>
                    </div>
                </div>
            </div>
        </div>
    
}