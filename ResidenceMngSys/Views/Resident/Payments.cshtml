@{
    ViewData["Title"] = "AidatÖde";
    ViewData["ActiveMenu"] = "payments";
    Layout = "~/Views/Shared/_ResidentLayout.cshtml";
}

@model ResidenceMngSys.Models.UserViewModel


<div style="margin-bottom: 2rem;">
    <h2 class="section-title" style="margin-bottom: 0.25rem;">Aidat Öde</h2>
    <p style="color: #64748b; font-size: 0.95rem; margin-bottom: 1.5rem;">
        Mevcut bakiyenizle aidat
        ödemesi yapabilirsiniz.
    </p>

    <div style="background: #0ea5e9; border-radius: 1rem; padding: 1.5rem 2rem; display: flex; align-items: center; justify-content: space-between; color: white;">
        <div>
            <div style="font-size: 0.95rem; margin-bottom: 0.25rem; font-weight: 500;">
                Kullanılabilir
                Bakiye
            </div>
            <div style="font-size: 2rem; font-weight: 700;">@Model.wallet.Balance.ToString("N2") ₺</div>
        </div>
        <div style="font-size: 3rem; opacity: 0.25;">
            <i class="fa-solid fa-wallet"></i>
        </div>
    </div>
</div>


<!-- 2. Pending Dues List -->
<div style="margin-bottom: 2rem;">
    <h3 style="font-size: 1.1rem; font-weight: 600; color: #334155; margin-bottom: 1rem;">
        Ödenecek Aidatlar (@Model.DuesList.Count(d => d.IsPaid == 0))
    </h3>

    @if (!Model.DuesList.Any(d => d.IsPaid == 0))
    {
        <div style="background: #f0fdf4; border: 1px solid #bbf7d0; border-radius: 1rem; padding: 1.5rem; text-align: center;">
            <i class="fa-solid fa-circle-check" style="color: #16a34a; font-size: 1.5rem; margin-bottom: 0.5rem;"></i>
            <p style="color: #16a34a; font-weight: 500;">Tüm aidatlarınız ödenmiş!</p>
        </div>
    }
    else
    {
        <div class="history-scroll-area" style="display: flex; flex-direction: column; gap: 1rem; max-height: 450px; overflow-y: auto; padding-right: 5px;">

            @foreach (var due in Model.DuesList.Where(d => d.IsPaid == 0))
            {
                <div style="background: white; border: 1px solid #e2e8f0; border-radius: 1rem; padding: 1.5rem; display: flex; align-items: center; justify-content: space-between; margin-bottom: 10px;">
                    <div style="flex: 1;">
                        <div style="display: flex; align-items: center; gap: 0.75rem; margin-bottom: 0.5rem;">
                            <i class="fa-regular fa-credit-card" style="color: #64748b;"></i>
                            <span style="font-weight: 600; color: #0f172a;">@due.Months @due.Year Aidatı</span>

                            @if (due.PaymentEndDate < DateTime.Now)
                            {
                                <span style="background: #fef2f2; color: #ef4444; font-size: 0.75rem; padding: 0.2rem 0.5rem; border-radius: 0.25rem; font-weight: 500;">
                                    <i class="fa-solid fa-circle-exclamation"></i> Gecikmiş
                                </span>
                            }
                            else
                            {
                                <span style="background: #eff6ff; color: #3b82f6; font-size: 0.75rem; padding: 0.2rem 0.5rem; border-radius: 0.25rem; font-weight: 500;">
                                    <i class="fa-regular fa-clock"></i> Bekliyor
                                </span>
                            }
                        </div>
                        <div style="color: #64748b; font-size: 0.9rem; margin-bottom: 0.75rem;">
                            Toplam: @due.DuesPrice.ToString("N0") ₺ &bull;
                            Kalan: <span style="color: #ef4444; font-weight: 500;">@due.RemainingDebt.ToString("N0") ₺</span>
                        </div>
                        <div style="color: #94a3b8; font-size: 0.85rem;">
                            Ödeme tarihi: @due.PaymentStartDate.ToString() - @due.PaymentEndDate.ToString()
                        </div>
                    </div>

                    <form asp-action="odemesayfasi" asp-controller="Resident" asp-route-id="@due.Id">
                        <button style="background: #2563eb; color: white; padding: 0.6rem 1.25rem; border-radius: 9999px; font-weight: 500; font-size: 0.9rem; border: none; cursor: pointer;">
                            Ödeme Yap →
                        </button>
                    </form>
                </div>
            }
        </div>
    }
</div>

<!-- 3. Payment History -->
<div class="card">
    <div class="card-header">
        <h3 class="card-title">Ödenmiş Aidatlar</h3>
    </div>

    <div class="history-scroll-area">
        <ul style="list-style: none; padding: 0; margin: 0;">
            @foreach (var due in Model.DuesList.Where(x => x.IsPaid == 1))
            {
                <li style="display: flex; justify-content: space-between; align-items: center; padding: 1rem 0; border-bottom: 1px solid var(--border-color);">
                    <div style="display: flex; align-items: center; gap: 1rem;">
                        <div class="widget-icon green" style="width: 36px; height: 36px; font-size: 0.9rem;">
                            <i class="fa-solid fa-check"></i>
                        </div>
                        <div>
                            <div class="user-name" style="font-size: 0.95rem;">
                                @due.Months / @due.Year Aidatı
                            </div>
                            <div class="user-role">
                                @due.PaymentStartDate.ToString() - @due.PaymentEndDate.ToString()
                            </div>
                        </div>
                    </div>
                    <div style="color: var(--primary-color); font-weight: 700;">
                        @due.DuesPrice.ToString("N0") ₺
                    </div>
                </li>
            }
        </ul>
    </div>
</div>