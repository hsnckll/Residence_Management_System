@{
    ViewData["Title"] = "Öneriler Ve Şikayetler";
    ViewData["ActiveMenu"] = "sikayet";
    Layout = "~/Views/Shared/_ResidentLayout.cshtml";
}

@model ResidenceMngSys.Models.UserViewModel

<div style="margin-bottom: 2rem; display: flex; justify-content: space-between; align-items: flex-start;">
    <div>
        <h2 class="section-title" style="margin-bottom: 0.25rem;">Şikayetler</h2>
        <p style="color: #64748b; font-size: 0.95rem;">Yönetime şikayet bildirin.</p>
    </div>
    <form asp-controller="Resident" asp-action="sikayetolustur" method="get">
        @* <input type="hidden" name="id" value="@Model.apartment.Id"/> *@
        <button style="background: #2563eb; color: white; padding: 0.75rem 1.25rem; border-radius: 9999px; font-weight: 500; font-size: 0.9rem; border: none; cursor: pointer; display: flex; align-items: center; gap: 0.5rem; transition: background 0.2s;"
                onmouseover="this.style.background='#1d4ed8'" onmouseout="this.style.background='#2563eb'">
            <i class="fa-solid fa-plus"></i> Şikayet Oluştur
        </button>
    </form>
    
</div>

<!-- Filters -->
<div class="tabs">
    <button onclick="filtrele('Tümü')" class="tab-btn active">Tümü</button>
    @* buradaki onclick mantığı demek oluyor ki git ve filtrele fonksiyonunu çalıştır demek oluyor *@
    <button onclick="filtrele('Beklemede')" class="tab-btn">Bekleyen</button>
    <button onclick="filtrele('İşlemde')" class="tab-btn">İşlemde</button>
    <button onclick="filtrele('Tamamlandı')" class="tab-btn">Tamamlandı</button>
</div>




<div style="display: flex; flex-direction: column; gap: 1rem;">
@foreach (var sikayet in Model.sikayetler)
{
    <!-- Complaints List -->

    <!-- Complaint Card 1 -->
    <div class="sikayet-card" data-status="@sikayet.Status"     style="background: white; border: 1px solid #e2e8f0; border-radius: 1rem; padding: 1.5rem;">
        <!-- Card Header -->
        <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 1rem;">
            <div style="display: flex; gap: 1rem;">
                <div style="width: 44px; height: 44px; border-radius: 0.75rem; background: #fef2f2; color: #ef4444; display: flex; align-items: center; justify-content: center; font-size: 1.25rem; flex-shrink: 0;">
                        <i class="fa-solid fa-triangle-exclamation"></i>
                </div>
                <div>
                    <div style="display: flex; align-items: center; gap: 0.75rem; margin-bottom: 0.25rem;">
                        <h3 style="font-size: 1.1rem; font-weight: 600; color: #0f172a;">
                            @sikayet.Topic
                        </h3>
                        <span style="background: #fef2f2; color: #ef4444; font-size: 0.75rem; padding: 0.15rem 0.5rem; border-radius: 0.75rem; font-weight: 500;">@sikayet.Type</span>
                    </div>
                        <div style="color: #94a3b8; font-size: 0.85rem;">Oluşturulma zamanı: @sikayet.CreatedAt.ToString("dd.MM.yyyy HH:mm")</div>
                        
                </div>
            </div>

            <!-- Status side -->
            <div style="text-align: right;">
                    @{
                        // Renk ve İkon Mantığı
                        string bgColor = "#ffedd5"; // Varsayılan: Beklemede (Turuncu)
                        string textColor = "#ea580c";
                        string iconClass = "fa-clock"; // Beklemede için saat ikonu

                        if (sikayet.Status == "İşlemde")
                        {
                            bgColor = "#e0f2fe"; // Mavi arka plan
                            textColor = "#0369a1"; // Koyu mavi yazı
                            iconClass = "fa-arrows-rotate fa-spin"; // İşlemde: Dönen oklar
                        }
                        else if (sikayet.Status == "Tamamlandı")
                        {
                            bgColor = "#dcfce7"; // Yeşil arka plan
                            textColor = "#15803d"; // Koyu yeşil yazı
                            iconClass = "fa-circle-check"; // Tamamlandı: Onay tiki
                        }
                    }
                <div style="display: inline-flex; align-items: center; gap: 0.4rem; background: @bgColor; color: @textColor; font-size: 0.8rem; padding: 0.25rem 0.75rem; border-radius: 9999px; font-weight: 500; margin-bottom: 0.5rem;">
                        <i class="fa-solid @iconClass" style="animation-duration: 3s;"></i> @sikayet.Status
                </div>



                <div style="color: #94a3b8; font-size: 0.85rem;">Tamamlanma zamanı: @(sikayet.CompletionAt?.ToString("dd.MM.yyyy HH:mm") ?? "Henüz Tamamlanmadı")</div>
            </div>
        </div>

        <!-- Card Body -->
        <p style="color: #475569; font-size: 0.95rem; line-height: 1.6; margin-bottom: 1.5rem;">
           @sikayet.Details
        </p>
            @if(sikayet.ImagePath!=null)
            {
                <div class="dekont-onizleme" style="margin-bottom: 1.5rem;">
                    @if (sikayet.ImagePath.EndsWith(".pdf"))
                    {
                        <a href="@sikayet.ImagePath" target="_blank" style="text-decoration: none; color: #dc2626; display: inline-flex; align-items: center; gap: 0.5rem;">
                            <i class="fa-solid fa-file-pdf fa-2x"></i>
                            <span style="font-weight: 500;">PDF'i Görüntüle</span>
                        </a>
                    }
                    else
                    {
                        <a href="@sikayet.ImagePath" target="_blank">
                            <img src="@sikayet.ImagePath" style="width: 120px; height: 90px; object-fit: cover; border-radius: 8px; border: 1px solid #e2e8f0;" />
                        </a>
                    }
                </div>
            }



        <!-- Response Block -->
        <div style="background: #eff6ff; border-radius: 0.75rem; padding: 1.25rem;">
            <h4 style="color: #1e40af; font-size: 0.85rem; font-weight: 600; margin-bottom: 0.5rem;">
                Yönetici Yanıtı:
            </h4>
            <p style="color: #2563eb; font-size: 0.95rem; line-height: 1.5; margin: 0;">
                @sikayet.AdminAnswer?.ToString()
            </p>
        </div>
    </div>

}
</div>




@section Scripts {
    <script>
        function filtrele(secilenDurum) {

            const tumKartlar = document.querySelectorAll('.sikayet-card');

            // 2. Butonların aktiflik durumunu güncelle (Görsel için)
            const butonlar = document.querySelectorAll('.tab-btn');
            butonlar.forEach(btn => btn.classList.remove('active')); // Hepsinden maviyi kaldır
            event.target.classList.add('active'); // Tıklanana mavi ekle

            // Bu kod satırları seçilen durumu gösterir diğer durumları gizler. Yaptığı şey budur
            tumKartlar.forEach(kart => {
                const kartinDurumu = kart.getAttribute('data-status');

                if (secilenDurum === 'Tümü' || kartinDurumu === secilenDurum) {
                    kart.style.display = 'block';
                } else {
                    kart.style.display = 'none';
                }
            });
        }
    </script>
}