    <table style="width:100%; font-size:14px; color:#374151; margin-top:12px;">
        <tr>
            <td style="padding:6px 0; color:#6b7280;">Aidat Dönemi</td>
            <td style="padding:6px 0; text-align:right; font-weight:600;">{{Month}} {{Year}}</td>
        </tr>
        <tr>
            <td style="padding:6px 0; color:#6b7280;">Eski Aidat Tutarı</td>
            <td style="padding:6px 0; text-align:right; font-weight:600; text-decoration:line-through; color:#9ca3af;">{{OldAmount}} TL</td>
        </tr>
        <tr>
            <td style="padding:6px 0; color:#6b7280;">Yeni Aidat Tutarı</td>
            <td style="padding:6px 0; text-align:right; font-weight:600;">{{NewAmount}} TL</td>
        </tr>
        <tr>
            <td style="padding:6px 0; border-top:1px solid #e5e7eb; color:#6b7280;">Bakiyeye Aktarılan</td>
            <td style="padding:6px 0; border-top:1px solid #e5e7eb; text-align:right; font-weight:600; color:#16a34a;">+{{RefundAmount}} TL</td>
        </tr>
